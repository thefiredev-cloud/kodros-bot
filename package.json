{
  "name": "meshbot",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@meshbot/api --filter=@meshbot/worker --filter=@meshbot/web --filter=@meshbot/sandbox-supervisor",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @meshbot/db generate",
    "db:migrate": "pnpm --filter @meshbot/db migrate",
    "sandbox:build": "docker build -t meshbot/computer:local infra/sandboxes/computer",
    "verify:fast": "vitest run",
    "verify": "tsx packages/testkit/src/cli/verify.ts",
    "verify:providers": "tsx packages/testkit/src/cli/verify.ts --providers",
    "e2e": "pnpm --filter @meshbot/web exec playwright test",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "shell-quote": "^1.12.0",
      "node-forge": "1.4.2",
      "http-cache-semantics": "4.3.0",
      "@grpc/grpc-js": "^1.14.5",
      "@vitest/mocker": "^4.1.12",
      "@xmldom/xmldom@~0.8.0": "^0.8.15",
      "@xmldom/xmldom@~0.9.0": "^0.9.12",
      "brace-expansion@^1.0.0": "^1.1.21",
      "brace-expansion@^2.0.0": "^2.1.7",
      "brace-expansion@^5.0.0": "^5.0.12",
      "compression": "^1.8.2",
      "decode-uri-component": "^0.5.1",
      "devalue": "^5.9.3",
      "fast-uri": "^3.1.9",
      "hono": "^4.13.11",
      "image-size": "^2.0.3",
      "js-yaml@^3.0.0": "^3.15.2",
      "js-yaml@^4.0.0": "^4.3.2",
      "markdown-it": "^14.3.3",
      "mysql2": "^3.23.1",
      "postcss": "^8.5.23",
      "smol-toml": "^1.9.0",
      "source-map-js": "^1.2.2",
      "svgo": "^4.1.0",
      "undici@^6.0.0": "^6.29.1",
      "undici@^7.0.0": "^7.30.1",
      "undici@^8.0.0": "^8.12.2",
      "uuid@^7.0.0": "^11.1.1",
      "uuid@^10.0.0": "^11.1.1",
      "vite@^7.0.0": "^7.3.7",
      "vite@^8.0.0": "^8.2.4",
      "vitest": "^4.1.12",
      "zod@^4.0.0": "^4.6.7"
    }
  }
}
